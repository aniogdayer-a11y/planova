GEMINI_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Deployment-only values; never include these in a Flutter build or Git commit.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
GEMINI_MODEL=gemini-3.5-flash-lite
PLANNER_HOST=127.0.0.1
PLANNER_PORT=8787
PLANNER_ALLOWED_ORIGINS=http://localhost:8787,http://127.0.0.1:8787

# Email OTP delivery (use a Gmail App Password, not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
COOKIE_SECURE=false

# Optional private Wi-Fi interface for phone/tablet development
PLANNER_LAN_HOST=
